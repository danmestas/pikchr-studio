+/* Record that the statement currently being parsed references pRef. */
+static PObj *studio_dep(Pik *p, PObj *pRef){
+  PObj *pCur = p->studioDepTarget;
+  int i;
+  if( pRef==0 || pCur==0 || pRef==pCur ) return pRef;
+  for(i=0; i<pCur->nStudioDep; i++){
+    if( pCur->aStudioDep[i]==pRef ) return pRef;
+  }
+  if( (pCur->nStudioDep & (pCur->nStudioDep-1))==0 ){
+    int nNew = pCur->nStudioDep ? pCur->nStudioDep*2 : 4;
+    PObj **aNew = realloc(pCur->aStudioDep, nNew*sizeof(PObj*));
+    if( aNew==0 ){ pik_error(p,0,0); return pRef; }
+    pCur->aStudioDep = aNew;
+  }
+  pCur->aStudioDep[pCur->nStudioDep++] = pRef;
+  return pRef;
+}
+/* Record the placement clause that begins at pTok. The clause ends where the
+** parser's lookahead token starts; trailing whitespace and comments are
+** trimmed when the scene is emitted. */
+static void studio_place(Pik *p, PToken *pTok){
+  PObj *pCur = p->studioDepTarget;
+  if( pCur==0 || pTok==0 ) return;
+  pCur->studioPlace = pTok->z;
+  pCur->studioPlaceEnd = p->studioTok;
