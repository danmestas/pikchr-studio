+/* Byte offset of the end of the last non-whitespace, non-comment token in
+** [zStart, zEnd). Returns the start offset when nothing is found. */
+static int studio_trim_end(Pik *p, const char *zStart, const char *zEnd){
+  const char *z = zStart;
+  const char *zLast = zStart;
+  if( zEnd>p->sIn.z+p->sIn.n ) zEnd = p->sIn.z+p->sIn.n;
+  while( z<zEnd ){
+    PToken t; int len;
+    memset(&t,0,sizeof(t)); t.z = z;
+    len = pik_token_length(&t,1);
+    if( len<=0 ) break;
+    if( z+len>zEnd ){ if( t.eType!=T_WHITESPACE ) zLast = zEnd; break; }
+    if( t.eType!=T_WHITESPACE ) zLast = z+len;
+    z += len;
+  }
+  return (int)(zLast - p->sIn.z);
+}
+static int studio_utf8_len(const unsigned char *z){
+  unsigned char c = z[0];
+  int n, i;
+  if( c<0x80 ) return 1;
+  if( c>=0xC2 && c<=0xDF ) n = 2;
+  else if( c>=0xE0 && c<=0xEF ) n = 3;
+  else if( c>=0xF0 && c<=0xF4 ) n = 4;
+  else return 0;
+  for(i=1; i<n; i++){ if( (z[i]&0xC0)!=0x80 ) return 0; }
+  if( n==3 ){
+    if( c==0xE0 && z[1]<0xA0 ) return 0;            /* overlong */
+    if( c==0xED && z[1]>=0xA0 ) return 0;           /* surrogate */
+  }else if( n==4 ){
+    if( c==0xF0 && z[1]<0x90 ) return 0;            /* overlong */
+    if( c==0xF4 && z[1]>=0x90 ) return 0;           /* > U+10FFFF */
+  }
+  return n;
+}
+/* Append s as a JSON string. Invalid UTF-8 bytes become U+FFFD so the
+** result is always valid JSON. */
+static void studio_string(Pik *j, const char *s){
+  const unsigned char *z = (const unsigned char*)(s ? s : "");
+  pik_append(j,"\"",1);
+  while(*z){
+    char b[8];
+    int n;
+    if(*z=='"' || *z=='\\'){
+      b[0]='\\'; b[1]=*z; pik_append(j,b,2); z++;
+    }else if(*z<32){
+      snprintf(b,sizeof(b),"\\u%04x",*z); pik_append(j,b,-1); z++;
+    }else if( (n = studio_utf8_len(z))>0 ){
+      pik_append(j,(const char*)z,n); z += n;
+    }else{
+      pik_append(j,"\xEF\xBF\xBD",3); z++;
+    }
+  }
+  pik_append(j,"\"",1);
+}
+static void studio_number(Pik *j, const char *prefix, double value){
+  char b[100];
+  snprintf(b,sizeof(b),"%s%.12g",prefix,isfinite(value)?value:0.0);
+  pik_append(j,b,-1);
+}
+static void studio_point(Pik *j, const char *prefix, double x, double y){
+  pik_append(j,prefix,-1);
