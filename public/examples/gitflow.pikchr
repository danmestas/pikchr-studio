# Gitflow learning example. Independently drawn; chronology runs downward.
# Native Pikchr source. Shapes and anchored connectors support Studio editing;
# coordinate-only lane guides remain source-editable.
fontscale = 1.2
DiagramTitle: text "Gitflow: a versioned release lifecycle" at (5.5,2.2) color 0x202b33
SymbolLegend: text "Circles: commits. Squares: numbered events." at (5.5,-15.2) color 0x202b33
ArrowLegend: text "Arrows: work and merges, not Git parent pointers." at (5.5,-15.6) color 0x202b33
thickness = 0.03
arrowht = 0.18
arrowwid = 0.12
ReleaseBoundary: line dashed from (-0.05,-4.65) to (4.6,-4.65) color 0xb9c4cc
BoundaryLabel: text "v1.1 scope fixed" at (1.1,-4.4) color 0x53616c
FixesOnly: text "Fixes only" at (5.08,-5.6) color 0x276d2b
FutureLane: line from (0.15,0.45) to (0.15,-14.6) color 0xe1e5e8
FeatureLane: line from (1.2,0.45) to (1.2,-14.6) color 0xe1e5e8
DevelopLane: line from (2.6,0.45) to (2.6,-14.6) color 0xe1e5e8
ReleaseLane: line from (4.2,0.45) to (4.2,-14.6) color 0xe1e5e8
HotfixLane: line from (5.8,0.45) to (5.8,-14.6) color 0xe1e5e8
MainLane: line from (7.4,0.45) to (7.4,-14.6) color 0xe1e5e8
Time: arrow from (-0.6,-0.1) to (-0.6,-14.4) color 0x6b737b
TimeLabel: text "Time" at (-0.6,0.7)
FeaturesLabel: text "feature" at (0.65,1.25) color 0x202b33
FeaturesSub: text "branches" at (0.65,0.93) color 0x202b33
DevelopLabel: text "develop" at (2.6,1.25) color 0x202b33
ReleaseLabel: text "release" at (4.2,1.25) color 0x202b33
HotfixLabel: text "hotfix" at (5.8,1.25) color 0x202b33
MainLabel: text "main" at (7.4,1.25) color 0x202b33
FutureLabel: text "Later" at (0.15,-0.85) color 0x202b33
SearchLabel: text "Search" at (1.2,-0.85) color 0x202b33
VersionStart: text "v1.0" at (8.13,0) color 0x202b33
VersionRelease: text "v1.1" at (8.13,-7.35) color 0x202b33
VersionHotfix: text "v1.1.1" at (8.13,-10.2) color 0x202b33
VersionNext: text "v1.2" at (8.13,-14) color 0x202b33
MainStart: circle "" radius 0.17 at (7.4,0) fill 31633 color 0x202b33
DevelopStart: circle "" radius 0.17 at (2.6,-0.7) fill 12684544 color 0x202b33
SearchStart: circle "" radius 0.17 at (1.2,-1.5) fill 11090054 color 0x202b33
SearchWork: circle "" radius 0.17 at (1.2,-2.35) fill 11090054 color 0x202b33
FutureStart: circle "" radius 0.17 at (0.15,-1.5) fill 11090054 color 0x202b33
FutureWork: circle "" radius 0.17 at (0.15,-3.5) fill 11090054 color 0x202b33
FeatureMerge: circle "" radius 0.17 at (2.6,-3.3) fill 12684544 color 0x202b33
ReleaseCut: circle "" radius 0.17 at (4.2,-4.2) fill 3639865 color 0x202b33
DevelopNext: circle "" radius 0.17 at (2.6,-5.15) fill 12684544 color 0x202b33
ReleaseFix: circle "" radius 0.17 at (4.2,-5.45) fill 3639865 color 0x202b33
ReleaseReady: circle "" radius 0.17 at (4.2,-6.6) fill 3639865 color 0x202b33
ReleaseMain: circle "" radius 0.17 at (7.4,-7.35) fill 31633 color 0x202b33
ReleaseBack: circle "" radius 0.17 at (2.6,-7.65) fill 12684544 color 0x202b33
FutureMore: circle "" radius 0.17 at (0.15,-6.4) fill 11090054 color 0x202b33
HotfixStart: circle "" radius 0.17 at (5.8,-8.3) fill 13127746 color 0x202b33
HotfixFix: circle "" radius 0.17 at (5.8,-9.3) fill 13127746 color 0x202b33
HotfixMain: circle "" radius 0.17 at (7.4,-10.2) fill 31633 color 0x202b33
HotfixBack: circle "" radius 0.17 at (2.6,-10.6) fill 12684544 color 0x202b33
FutureFinish: circle "" radius 0.17 at (0.15,-10.8) fill 11090054 color 0x202b33
FutureMerge: circle "" radius 0.17 at (2.6,-12) fill 12684544 color 0x202b33
NextRelease: circle "" radius 0.17 at (4.2,-12.9) fill 3639865 color 0x202b33
NextMain: circle "" radius 0.17 at (7.4,-14) fill 31633 color 0x202b33
NextBack: circle "" radius 0.17 at (2.6,-14.25) fill 12684544 color 0x202b33
StartDevelopment: arrow from MainStart.sw to DevelopStart.ne color 9081754
BranchSearch: arrow from DevelopStart.sw to SearchStart.ne color 11090054
SearchProgress: arrow from SearchStart.s to SearchWork.n color 11090054
BranchFuture: arrow from DevelopStart.w to FutureStart.ne color 11090054
FutureProgress: arrow from FutureStart.s to FutureWork.n color 11090054
FeatureMergeArrow: arrow from SearchWork.se to FeatureMerge.nw color 11090054
DevelopProgress: arrow from DevelopStart.s to FeatureMerge.n color 12684544
CutReleaseArrow: arrow from FeatureMerge.se to ReleaseCut.nw color 3639865
DevelopNextArrow: arrow from FeatureMerge.s to DevelopNext.n color 12684544
ReleaseFixArrow: arrow from ReleaseCut.s to ReleaseFix.n color 3639865
ReleaseReadyArrow: arrow from ReleaseFix.s to ReleaseReady.n color 3639865
ReleaseToMain: arrow from ReleaseReady.se to ReleaseMain.nw color 3639865
ReleaseToDevelop: arrow from ReleaseReady.sw to ReleaseBack.ne color 3639865
MainReleaseProgress: arrow from MainStart.s to ReleaseMain.n color 31633
DevelopReleaseProgress: arrow from DevelopNext.s to ReleaseBack.n color 12684544
FutureContinues: arrow from FutureWork.s to FutureMore.n color 11090054
BranchHotfix: arrow from ReleaseMain.sw to HotfixStart.ne color 13127746
HotfixProgress: arrow from HotfixStart.s to HotfixFix.n color 13127746
HotfixToMain: arrow from HotfixFix.se to HotfixMain.nw color 13127746
HotfixToDevelop: arrow from HotfixFix.sw to HotfixBack.ne color 13127746
MainPatchProgress: arrow from ReleaseMain.s to HotfixMain.n color 31633
DevelopPatchProgress: arrow from ReleaseBack.s to HotfixBack.n color 12684544
FutureContinuesAgain: arrow from FutureMore.s to FutureFinish.n color 11090054
FutureToDevelop: arrow from FutureFinish.se to FutureMerge.nw color 11090054
DevelopFutureProgress: arrow from HotfixBack.s to FutureMerge.n color 12684544
CutNextRelease: arrow from FutureMerge.se to NextRelease.nw color 3639865
NextReleaseToMain: arrow from NextRelease.se to NextMain.nw color 3639865
NextReleaseToDevelop: arrow from NextRelease.sw to NextBack.ne color 3639865
MainNextProgress: arrow from HotfixMain.s to NextMain.n color 31633
DevelopNextReleaseProgress: arrow from FutureMerge.s to NextBack.n color 12684544
EventBaseline: box "1  Stable baseline" "Production: v1.0" "Development starts" width 3.2 height 1.0 at (10.25,0) fill 0xf5f7f8 color 0x202b33
EventFeature: box "2  Parallel features" "Search joins develop" "Later stays separate" width 3.2 height 1.0 at (10.25,-2.25) fill 0xf5f7f8 color 0x202b33
EventCut: box "3  Cut release/1.1" "Stabilize this release" "Develop keeps moving" width 3.2 height 1.0 at (10.25,-4.9) fill 0xf5f7f8 color 0x202b33
EventShip: box "4  Ship v1.1" "Merge release into" "main AND develop" width 3.2 height 1.0 at (10.25,-7.1) fill 0xf5f7f8 color 0x202b33
EventPatch: box "5  Urgent hotfix" "Branch from main" "Merge to BOTH lanes" width 3.2 height 1.0 at (10.25,-9.55) fill 0xf5f7f8 color 0x202b33
EventReturn: box "6  Finish Later" "Merge into develop" "Not retroactively v1.1" width 3.2 height 1.0 at (10.25,-11.7) fill 0xf5f7f8 color 0x202b33
EventNext: box "7  Ship v1.2" "Later reaches main" "Tag a new release" width 3.2 height 1.0 at (10.25,-13.8) fill 0xf5f7f8 color 0x202b33
# Square numbers connect events to the explanation rail; circles remain commits.
MarkerOne: box "1" width 0.34 height 0.34 at (6.9,0.35) fill 0xffffff color 0x202b33
MarkerOneLeader: line from MarkerOne.se to MainStart.nw color 0x7a848d
MarkerTwo: box "2" width 0.34 height 0.34 at (3.12,-2.9) fill 0xffffff color 0x202b33
MarkerTwoLeader: line from MarkerTwo.sw to FeatureMerge.ne color 0x7a848d
MarkerThree: box "3" width 0.34 height 0.34 at (4.72,-3.82) fill 0xffffff color 0x202b33
MarkerThreeLeader: line from MarkerThree.sw to ReleaseCut.ne color 0x7a848d
MarkerFour: box "4" width 0.34 height 0.34 at (4.75,-6.22) fill 0xffffff color 0x202b33
MarkerFourLeader: line from MarkerFour.sw to ReleaseReady.ne color 0x7a848d
MarkerFive: box "5" width 0.34 height 0.34 at (6.35,-8.92) fill 0xffffff color 0x202b33
MarkerFiveLeader: line from MarkerFive.sw to HotfixFix.ne color 0x7a848d
MarkerSix: box "6" width 0.34 height 0.34 at (3.12,-11.6) fill 0xffffff color 0x202b33
MarkerSixLeader: line from MarkerSix.sw to FutureMerge.ne color 0x7a848d
MarkerSeven: box "7" width 0.34 height 0.34 at (4.75,-12.5) fill 0xffffff color 0x202b33
MarkerSevenLeader: line from MarkerSeven.sw to NextRelease.ne color 0x7a848d
