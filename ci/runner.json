{
  "tasks": {
    "pikchr-studio.test": {
      "argv": [
        "npm",
        "test"
      ],
      "env": {
        "PIKCHR_STUDIO_DIAG": "1",
        "PIKCHR_STUDIO_TAIL": "80"
      }
    },
    "pikchr-studio.worker": [
      "npx",
      "--yes",
      "wrangler@4.138.0",
      "deploy",
      "--dry-run",
      "--outdir",
      "dist-dry-run"
    ],
    "pikchr-studio.deploy": [
      "npx",
      "--yes",
      "wrangler@4.138.0",
      "deploy"
    ]
  }
}
